# Supabase Postgres connection string (use the Transaction pooler URI for serverless)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# Admin accounts — comma-separated Name:password pairs, so status changes
# and quotes can be attributed to a person (see src/lib/auth.ts).
# Example: ADMIN_USERS="Ahmed:mypassword,Sarah:herpassword"
ADMIN_USERS="Admin:change-me"

# Fallback used only if ADMIN_USERS isn't set (creates a single "Admin" account)
ADMIN_PASSWORD=change-me

# Resend (https://resend.com) — used to email customers their tracking number
# when an order is confirmed. Leave unset to log emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM="MA Logistics <dispatch@malogisticsza.com>"

# Optional — protects /api/cron/follow-ups from being triggered by randoms.
# Set this in Vercel and it's sent automatically for Vercel's own cron calls.
CRON_SECRET=
