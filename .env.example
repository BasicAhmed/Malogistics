# Supabase Postgres connection string (use the Transaction pooler URI for serverless)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# Shared password for the /admin dashboard (MVP-level auth — see src/lib/auth.ts)
ADMIN_PASSWORD=change-me

# Resend (https://resend.com) — used to email customers their tracking number
# when an order is confirmed. Leave unset to log emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM="MA Logistics <dispatch@malogistics.co>"
